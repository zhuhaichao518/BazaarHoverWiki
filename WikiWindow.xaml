<Window x:Class="BazaarHoverWiki.WikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bazaar Wiki"
        Width="470"
        Height="760"
        MinWidth="360"
        MinHeight="420"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#141923">
    <Border BorderBrush="#D5A44E" BorderThickness="1" Background="#141923">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#202838" Padding="12,0">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F2D18D"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#AAB4C4"
                               Text="F9 解锁交互"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Browser"/>
                <Border x:Name="LoadingPanel" Background="#141923">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Text="等待识别选项…"/>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#929EB1"
                                   Text="将鼠标停在名称附近，或按 Ctrl+Shift+W"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#202838" Padding="10,0">
                <TextBlock x:Name="ModeText"
                           VerticalAlignment="Center"
                           Foreground="#9DA8B8"
                           Text="穿透模式 · F9 可操作网页"/>
            </Border>
        </Grid>
    </Border>
</Window>
