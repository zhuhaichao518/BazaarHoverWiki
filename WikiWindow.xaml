<Window x:Class="BazaarHoverWiki.WikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bazaar Wiki"
        Width="470"
        Height="760"
        MinWidth="360"
        MinHeight="420"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="#141923">
    <Border BorderBrush="#D5A44E" BorderThickness="1" Background="#141923">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#202838"
                    Padding="12,0"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F2D18D"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#AAB4C4"
                               Text="D 隐藏 · F9 暂停 · 拖动此处移动"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Browser"/>
                <Border x:Name="LoadingPanel" Background="#141923">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Text="等待识别选项…"/>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#929EB1"
                                   Text="将鼠标停在名称附近按 F 搜索；按 D 隐藏"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#202838" Padding="10,0">
                <Grid>
                    <TextBlock x:Name="ModeText"
                               VerticalAlignment="Center"
                               Foreground="#9DA8B8"
                               Text="可直接操作网页 · 拖动边缘或右下角缩放"/>
                    <ResizeGrip Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
