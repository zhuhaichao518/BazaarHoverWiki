<Window x:Class="BazaarHoverWiki.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bazaar Hover Wiki"
        Width="520"
        Height="380"
        MinWidth="470"
        MinHeight="350"
        Background="{StaticResource PanelBrush}"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Text="Bazaar Hover Wiki"/>
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="纯外部截图 OCR · 不注入游戏 · 不读内存"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="7"
                Background="{StaticResource CardBrush}">
            <StackPanel>
                <DockPanel>
                    <Ellipse x:Name="StatusDot"
                             Width="10"
                             Height="10"
                             Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             Fill="#67D391"/>
                    <TextBlock x:Name="StatusText"
                               FontSize="15"
                               Text="正在初始化 OCR…"/>
                </DockPanel>
                <TextBlock x:Name="ForegroundText"
                           Margin="19,7,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="前台窗口：—"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,6"
                       Foreground="{StaticResource MutedBrush}"
                       Text="识别/手动搜索"/>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Content="查看 Wiki"
                        Click="SearchButton_OnClick"/>
                <TextBox x:Name="QueryTextBox"
                         FontSize="15"
                         KeyDown="QueryTextBox_OnKeyDown"/>
            </DockPanel>
            <TextBlock x:Name="CandidateText"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="候选：—"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="13"
                CornerRadius="7"
                Background="#111722">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="快捷键"/>
                <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="F　识别鼠标附近并搜索 Wiki"/>
                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="D　显示/隐藏 Wiki 窗口"/>
                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="F9　暂停/恢复插件（释放 F、D）"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <Button Content="显示 Wiki 窗口"
                    Click="ShowWikiButton_OnClick"/>
            <TextBlock x:Name="OcrLanguageText"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}"
                       Text="OCR：—"/>
        </DockPanel>
    </Grid>
</Window>
