<Application x:Class="BazaarHoverWiki.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B24"/>
        <SolidColorBrush x:Key="CardBrush" Color="#222938"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E4B45B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9CA7B8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#32405A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#53617A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Background" Value="#10141C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#465168"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8ECF4"/>
        </Style>
    </Application.Resources>
</Application>
